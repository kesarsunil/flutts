rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'kesharsunil1@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /parking_slots/{slotId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /booking_history/{bookingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /users/{userId}/booking_history/{bookingId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow write: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
